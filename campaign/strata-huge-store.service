# strata-huge-store.service - the 2 MiB store mount (HOSTMEM-NO-REBOOT.md, M1-final/M5).
# The root probe (2026-11-07) killed the tmpfs huge= route on this kernel: shmem PMD folios never
# materialize (within_size AND always, write-fault AND MADV_COLLAPSE - 0 kB promoted at root).
# hugetlbfs needs no THP policy: pages are 2 MiB by construction, unswappable, unfragmentable.
# The store copy on it draws from the vm.nr_hugepages pool (campaign/91-strata-hugepages.conf),
# same pool the engines' MAP_HUGETLB arenas draw from - one supply, guaranteed class.
# Install (with the pool reservation - see campaign/HOSTMEM-NO-REBOOT.md):
#   sudo systemctl disable --now strata-huge-tmpfs.service 2>/dev/null; sudo rm -f /usr/lib/systemd/system/strata-huge-tmpfs.service
#   sudo cp campaign/strata-huge-store.service /usr/lib/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now strata-huge-store
[Unit]
Description=Strata huge-page store mount (the shadow store on 2 MiB pages, by construction)
Documentation=file:///home/svg/LLM/strata-custom-2/campaign/HOSTMEM-NO-REBOOT.md
After=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/mkdir -p /mnt/strata-huge
ExecStart=/usr/bin/mount -t hugetlbfs -o uid=1000,gid=1000,mode=0755,pagesize=2M,size=40G strata-hugepages /mnt/strata-huge
ExecStop=/usr/bin/umount -f /mnt/strata-huge

[Install]
WantedBy=multi-user.target
