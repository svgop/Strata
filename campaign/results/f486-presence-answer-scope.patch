+def answer_scoped_sampling(sampling):
+    """The answer phase's sampling: the presence penalty is zeroed, the vendor's own precise-coding set being
+    presence 0 while its general sets carry 1.5 (F-481).  A client's temperature, top_p, top_k and its request
+    dict are never touched; the frequency and repetition penalties stay what the request set.  Composes with
+    #728: the loop-guard's recovery raises the presence penalty again when an answer truly repeats itself."""
+    s = dict(sampling or {})
+    if float(s.get("presence_penalty") or 0) != 0:
+        s["presence_penalty"] = 0.0
+    return s
+
