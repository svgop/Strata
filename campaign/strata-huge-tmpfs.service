# strata-huge-tmpfs.service - M1 (campaign/HOSTMEM-NO-REBOOT.md): the shadow store's huge-folio home.
# tmpfs mounted huge=within_size: shmem PMD folios where the kernel grants them.  The store on
# /dev/shm never got one on this box (shmem_enabled=never) - 38 GiB of 4K shmem was one of the
# three degradation organs.  Install:
#   sudo cp campaign/strata-huge-tmpfs.service /usr/lib/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now strata-huge-tmpfs
# Nothing else changes: campaign/shm-shadow.sh and the launchers pick the tier by presence.
[Unit]
Description=Strata huge-folio tmpfs (the shadow store placement cache on 2 MiB folios)
Documentation=file:///home/svg/LLM/strata-custom-2/campaign/HOSTMEM-NO-REBOOT.md
After=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/mkdir -p /mnt/strata-huge
ExecStart=/usr/bin/mount -t tmpfs -o size=48G,huge=within_size,mode=0755,nosuid,nodev strata-huge /mnt/strata-huge
ExecStop=/usr/bin/umount -f /mnt/strata-huge

[Install]
WantedBy=multi-user.target
