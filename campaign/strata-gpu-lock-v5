#!/usr/bin/bash
# strata-gpu-lock v5 — v4 floor-range SM + HARD-PIN memory while a Strata engine runs.
#
# v4 leaves memory inside a DVFS range (-lmc 7001,14001). The +2 ms/window all-lane
# GPU-side deficit (~-15%) appeared EXACTLY at the v2→v3/v4 cutover (Nov-07 15:23).
# Hypothesis under test: SM boost is a microsecond DVFS step (the Nov-07 digest proved it),
# but MEMORY clock ramp is slow relative to decode bursts — under the range the card serves
# short bursts at whatever mem bin it already holds (mclk floating 7001-13801 in the Nov-09
# quiet-with-floor capture; sustained mem reads 13801, never the pinned 14001), while v2's
# hard pin kept 14001 through every burst. v5 splits the regime:
#   - SM keeps v4's floor-range (-lgc SM_FLOOR,SM_MAX): the hardware owns the boost
#     decision; the v2 1780-plateau defect (measured ~30% lane loss, clockwatch proof)
#     is NOT reintroduced
#   - MEM is HARD-PINNED (-lmc MEM_MAX,MEM_MAX = 14001,14001) while an engine listens:
#     min=max blocks mem DVFS entirely, so every burst enters at full bandwidth. The pin's
#     cost is watts (static GDDR clock power while idle, switching power when data moves);
#     the 575 W cap trims SM exactly as it did all of the v2 era (Nov-7 dmon proof:
#     pinned mem 14001 with SM trimmed to ~2830-2955 sustained)
#   - no engine listening: full release (-rgc -rmc), unchanged
# Everything else is v4 verbatim:
#   - WATCHDOG dead-man: Type=notify + systemd-notify WATCHDOG=1 each loop — a hung service
#     is killed and restarted by systemd, and the ExecStopPost release always runs
#   - `-i 0` device scoping on every nvidia-smi call
#   - clocks_event_reasons guardrail: 0x8 (sw power cap) | 0x40 (hw slowdown) | 0x80 (sync
#     boost) => log only, the card is protecting itself; the thermal shed path handles it
#     (0x400 = the RELIABILITY derate (V/F trim), NOT a fault: quiet-with-floor reads
#     exactly 0x400 on this driver - it is normal and never shed)
#   - SUPPORTED_CLOCKS stays banned from the runtime loop (GSP hang vector on open-module
#     610.x GB203; grid values are config only)
#   - thermal shed/resume (83C/78C), port-contract engine detection, GRACE release
# MEM_PIN=1 (default) = this design. MEM_PIN=0 in /etc/sysconfig/strata-gpu-lock reverts
# the SAME script to exact v4 mem-range behavior; `systemctl reload strata-gpu-lock`
# re-reads it (HUP trap) without a restart.
# Config: /etc/sysconfig/strata-gpu-lock (SIGHUP reload via systemctl reload).
#   MEM_PIN / SM_FLOOR / SM_MAX / MEM_FLOOR / MEM_MAX / TEMP_SHED / TEMP_RESUME / PORTS /
#   GRACE / POLL  (v2 names SM_CLOCK/MEM_CLOCK/SM_MID still honored)
set -u
PATH=/usr/bin:/bin:/usr/sbin:/sbin

NSMI=/usr/bin/nvidia-smi
DEV=0
PORTS="8080 8081"
GRACE=45
POLL=3
SM_FLOOR=1800
MEM_FLOOR=7001
SM_MAX=3135
MEM_MAX=14001
MEM_PIN=1        # 1 = hard-pin mem at MEM_MAX while listening (v5); 0 = v4 range behavior
TEMP_SHED=83      # C: shed the floor (release to DVFS) at or above this
TEMP_RESUME=78    # C: re-apply the floor below this
DRY=${DRY:-0}
TAG=${TAG:-strata-gpu-lock}
[ -r /etc/sysconfig/strata-gpu-lock ] && . /etc/sysconfig/strata-gpu-lock
SM_MAX=${SM_CLOCK:-$SM_MAX}        # v1/v2 names still honored
MEM_MAX=${MEM_CLOCK:-$MEM_MAX}
SM_FLOOR=${SM_MID:-$SM_FLOOR}      # v2's "mid" becomes the floor

log() { logger -t "$TAG" "$*"; }

mem_mode() {   # journal-facing description of the active mem regime
    if [ "$MEM_PIN" = 1 ]; then printf 'HARD PIN %s' "$MEM_MAX"
    else printf 'range %s-%s' "$MEM_FLOOR" "$MEM_MAX"; fi
}

# the watchdog dead-man: systemd kills a hung service (Type=notify, WatchdogSec in the unit)
wd_ping() { systemd-notify WATCHDOG=1 2>/dev/null || true; }

engine_running() {
    local p
    for p in $PORTS; do
        ss -tlnH "sport = :$p" 2>/dev/null | grep -q . && return 0
    done
    return 1
}

# one batched read: temp + the event-reason guardrail bits (no SUPPORTED_CLOCKS ever)
gpu_read() {   # sets gpu_temp / gpu_reason
    local out
    out=$("$NSMI" -i "$DEV" --query-gpu=temperature.gpu,clocks_event_reasons.active --format=csv,noheader,nounits 2>/dev/null | head -1)
    gpu_temp=${out%%,*}
    gpu_reason=${out#*,}
    gpu_temp=${gpu_temp:-0}
    gpu_reason=$(( gpu_reason + 0 ))   # hex mask in, integer out; empty -> 0
}

apply() {   # floor | off
    [ "$DRY" = 1 ] && return 0
    [ -x "$NSMI" ] || return 1
    case "$1" in
        floor) "$NSMI" -i "$DEV" -pm 1 >/dev/null 2>&1 || return 1
               "$NSMI" -i "$DEV" -lgc "$SM_FLOOR,$SM_MAX" >/dev/null 2>&1 || return 1
               if [ "$MEM_PIN" = 1 ]; then
                   # v5: hard pin min=max — mem DVFS cannot downshift/ramp inside a burst
                   "$NSMI" -i "$DEV" -lmc "$MEM_MAX,$MEM_MAX" >/dev/null 2>&1 || return 1
               else
                   # v4 behavior: range lock, DVFS owns the mem bin
                   "$NSMI" -i "$DEV" -lmc "$MEM_FLOOR,$MEM_MAX" >/dev/null 2>&1 || return 1
               fi ;;
        off)   "$NSMI" -i "$DEV" -rgc >/dev/null 2>&1
               "$NSMI" -i "$DEV" -rmc >/dev/null 2>&1 ;;
    esac
    return 0
}

trap 'apply off; log "service stopped — clocks released"; exit 0' TERM INT
trap '
      . /etc/sysconfig/strata-gpu-lock 2>/dev/null || true
      SM_MAX=${SM_CLOCK:-3135}; MEM_MAX=${MEM_CLOCK:-14001}; SM_FLOOR=${SM_MID:-$SM_FLOOR}
      MEM_PIN=${MEM_PIN:-1}
      if [ "$state" != off ]; then apply floor && log "reload — floor re-applied (${SM_FLOOR}-${SM_MAX} sm, $(mem_mode) mem)"; fi' HUP

state=off
gone=0
shed=0
guard=0
log "watching v5 (floor ${SM_FLOOR}-${SM_MAX} sm / mem $(mem_mode) while an engine listens; sm boost is the hardware's; thermal shed ${TEMP_SHED}C, resume ${TEMP_RESUME}C, engine grace ${GRACE}s, poll ${POLL}s, watchdog dead-man on)"
systemd-notify --ready 2>/dev/null || true   # Type=notify: without READY=1 systemd times the start out
while :; do
    wd_ping
    if engine_running; then
        gone=0
        gpu_read
        if [ "$gpu_temp" -ge "$TEMP_SHED" ] && [ "$shed" -eq 0 ]; then
            apply off; shed=1
            log "thermal shed at ${gpu_temp}C — clocks released until ${TEMP_RESUME}C"
        elif [ "$shed" -eq 1 ] && [ "$gpu_temp" -le "$TEMP_RESUME" ]; then
            shed=0
            if apply floor; then log "cooled to ${gpu_temp}C — floor re-applied (${SM_FLOOR}-${SM_MAX} sm, $(mem_mode) mem)"; fi
        else
            # the card's own protection bits (0x8 sw cap | 0x40 hw slowdown | 0x80 sync boost):
            # never fight them - log once per transition, the floor stays (they cap ABOVE it)
            if [ $(( gpu_reason & 0xC8 )) -ne 0 ] && [ "$guard" != 1 ]; then
                guard=1
                log "guardrail: clocks_event_reasons=0x$(printf '%x' "$gpu_reason") (power/hw cap active) — the card limits itself, the floor stays"
            elif [ $(( gpu_reason & 0xC8 )) -eq 0 ] && [ "$guard" = 1 ]; then
                guard=0
                log "guardrail clear — the card's caps lifted"
            fi
            if [ "$shed" -eq 0 ] && [ "$state" != floor ]; then
                if apply floor; then
                    state=floor
                    log "engine listening — clock floor ${SM_FLOOR}-${SM_MAX} sm / mem $(mem_mode) (sm boost instant; mem bandwidth full from burst entry)"
                fi
            fi
        fi
    else
        shed=0
        guard=0
        if [ "$state" != off ]; then
            gone=$(( gone + POLL ))
            if [ "$gone" -ge "$GRACE" ]; then
                apply off
                state=off
                log "engine gone ${GRACE}s — clocks released"
            fi
        fi
    fi
    sleep "$POLL"
done
